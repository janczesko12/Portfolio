rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "janczesko12@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /applications/{applicationId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name','description','platform','version','sortOrder','imageUrl',
          'downloadUrl','websiteUrl','buttonLabel','published','createdAt',
          'createdBy','updatedAt','updatedBy'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1200
        && request.resource.data.sortOrder is int
        && request.resource.data.published is bool
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name','description','platform','version','sortOrder','imageUrl',
          'downloadUrl','websiteUrl','buttonLabel','published','createdAt',
          'createdBy','updatedAt','updatedBy'
        ])
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /portfolio_ratings/{ratingId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly([
          'rating',
          'comment',
          'createdAt',
          'language'
        ]) &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() <= 300 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.language is string &&
        request.resource.data.language.size() <= 2;
      allow update, delete: if false;
    }

    // Public visit counter. Only the aggregate document can be updated,
    // and only by adding exactly one to the existing numeric count.
    match /portfolio_stats/visits {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && resource.data.keys().hasOnly(['count'])
        && resource.data.count is int
        && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }
    
    // Newsletter signups: public create only; subscriber data remains private.
    match /newsletter_subscribers/{subscriberId} {
      allow read, update, delete: if isAdmin();
      allow create: if
        subscriberId.matches('^[a-f0-9]{64}$') &&
        request.resource.data.keys().hasOnly([
          'email', 'consent', 'createdAt', 'language', 'source'
        ]) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$') &&
        request.resource.data.consent == true &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.language in ['pl', 'en'] &&
        request.resource.data.source == 'novydev.pl';
    }

  }
}