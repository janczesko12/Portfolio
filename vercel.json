{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/gra",
      "destination": "/gra/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/aplikacje/LibrusSync/altstore",
      "destination": "/aplikacje/LibrusSync/altstore/source.json"
    },
    {
      "source": "/gra/designer.html",
      "destination": "https://huntly-janczesko12s-projects.vercel.app/designer.html"
    },
    {
      "source": "/gra/designer",
      "destination": "https://huntly-janczesko12s-projects.vercel.app/designer.html"
    },
    {
      "source": "/gra/",
      "destination": "https://huntly-janczesko12s-projects.vercel.app/"
    },
    {
      "source": "/gra/:path*",
      "destination": "https://huntly-janczesko12s-projects.vercel.app/:path*"
    }
  ]
}
